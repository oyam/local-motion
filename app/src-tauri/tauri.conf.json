{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [
      "models/*.onnx"
    ],
    "shortDescription": "",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "productName": "local-motion",
  "mainBinaryName": "local-motion",
  "version": "../package.json",
  "identifier": "local-motion",
  "plugins": {},
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Main Window",
        "url": "/src/windows/main/",
        "fullscreen": false,
        "resizable": true,
        "width": 0,
        "height": 0,
        "transparent": true,
        "decorations": false,
        "focus": false,
        "useHttpsScheme": true
      },
      {
        "label": "settings",
        "title": "Local Motion Settings",
        "url": "/src/windows/settings/",
        "visible": false,
        "resizable": false,
        "width": 1200,
        "height": 800,
        "focus": false,
        "acceptFirstMouse": true,
        "useHttpsScheme": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  }
}